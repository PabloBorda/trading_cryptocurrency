+
+class PublicAPI:
+    def __init__(self):
+        pass
+
+    def __str__(self):
+        return str(dir(PublicAPI))
+
+    @staticmethod
+    def ping():
+        url = "/api/v1/ping"
+        path = f"{BASE_URL}{url}"
+        return requests.get(path, timeout=30, verify=True).json()
+
+    @staticmethod
+    def get_server_time():
+        url = "/api/v1/time"
+        path = f"{BASE_URL}{url}"
+        return requests.get(path, timeout=30, verify=True).json()
+
+    @staticmethod
+    # @json_format
+    def get_exchange_info():
+        url = "/api/v1/exchangeInfo"
+        path = f"{BASE_URL}{url}"
+        return requests.get(path, timeout=30, verify=True).json()
+
+    @staticmethod
+    def get_depth(symbol, limit=100):
+        url = "/api/v1/depth"
